{
  "name": "ai-screenwriting-tool",
  "version": "1.0.0",
  "description": "Screenwriting app: page-accurate screenplay editor with outlining, beats and reports; macOS shell in mac/",
  "private": true,
  "scripts": {
    "dev": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "test": "cd client && npm test",
    "typecheck": "cd client && npm run typecheck",
    "install:all": "npm install && cd client && npm install",
    "app": "cd mac && ./build-app.sh",
    "app:install": "cd mac && ./build-app.sh --install"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lwhela12/AI-Screenwriting-Tool.git"
  },
  "keywords": [
    "screenwriting",
    "screenplay",
    "script",
    "editor",
    "ai",
    "writing"
  ],
  "author": "",
  "license": "MIT"
}
